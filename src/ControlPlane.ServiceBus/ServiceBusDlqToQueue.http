@apiBaseUrl = http://localhost:5149
@apiToken = {{$dotenv CONTROL_PLANE_API_TOKEN}}
@projectId = {{$dotenv CONTROL_PLANE_PROJECT_ID}}
@sourceDlqPath = {{$dotenv CONTROL_PLANE_SERVICEBUS_SOURCE_DLQ_PATH}}
@queueName = {{$dotenv CONTROL_PLANE_SERVICEBUS_QUEUE_NAME}}
@requestedBy = {{$dotenv CONTROL_PLANE_REQUESTED_BY}}

POST {{apiBaseUrl}}/api/operations/execute
Content-Type: application/json
Authorization: Bearer {{apiToken}}

{
  "projectId": "{{projectId}}",
  "operationId": "resend-servicebus-dlq-to-queue",
  "input": {
    "sourceDlqPath": "{{sourceDlqPath}}",
    "queueName": "{{queueName}}"
  },
  "requestedBy": "{{requestedBy}}"
}
