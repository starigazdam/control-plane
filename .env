# Control Plane — environment configuration
# Committed defaults. Override locally by creating a .env.local file (gitignored).

# ── General ────────────────────────────────────────────────────────────────
ConnectionStrings__ControlPlane=Data Source=control-plane.db

# ── Azure plugin ───────────────────────────────────────────────────────────
Azure__TenantId=
Azure__SubscriptionId=
Azure__ClientId=
Azure__ClientSecret=

# ── Service Bus plugin ──────────────────────────────────────────────────────
ServiceBus__ConnectionString=
# Comma-separated queue names
ServiceBus__MonitoredQueues=

# ── Kafka plugin ────────────────────────────────────────────────────────────
Kafka__BootstrapServers=localhost:9092
# Comma-separated consumer group IDs
Kafka__MonitoredConsumerGroups=
# Comma-separated DLQ topic names
Kafka__DlqTopics=
Kafka__ConsumerLagWarningThreshold=1000

# ── DevOps plugin ───────────────────────────────────────────────────────────
DevOps__OrgUrl=https://dev.azure.com/your-org
DevOps__PersonalAccessToken=
# Comma-separated Azure DevOps project names
DevOps__MonitoredProjects=
DevOps__LookbackHours=24
