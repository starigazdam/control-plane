# Git metadata
.git
.gitattributes
.gitignore

# Local dotenv files and secrets at any depth. The build context is recursive,
# so these patterns must match nested paths too. No dotenv file is copied into
# the image; the secret-free .env.example templates are re-included last.
**/.env
**/.env.*
**/*.env
**/*.local

# Local runtime databases and their sidecars at any depth
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

# Test evidence
**/TestResults/
**/*.trx
**/*.coverage
**/coverage*.json
**/coverage*.xml

# Build caches and dependency caches (compiled output is produced in build stages)
**/bin/
**/obj/
**/dist/
**/node_modules/
**/.vite/
**/.aspire/

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tests and their fixtures are not needed to build the image
tests/

# Keep the safe, secret-free dotenv template at any depth. This must stay last
# so it wins over the recursive dotenv exclusions above.
!**/.env.example
