# Control Plane — environment configuration
# Committed defaults. Override locally by creating a .env.local file (gitignored).

# ── General ────────────────────────────────────────────────────────────────
ConnectionStrings__ControlPlane=Data Source=control-plane.db

# ── Azure plugin ───────────────────────────────────────────────────────────
Azure__TenantId=
Azure__SubscriptionId=
Azure__ClientId=
Azure__ClientSecret=

# ── Service Bus plugin ──────────────────────────────────────────────────────
ServiceBus__ConnectionString=
# Comma-separated queue names
ServiceBus__MonitoredQueues=

# ── Kafka plugin ────────────────────────────────────────────────────────────
Kafka__BootstrapServers=localhost:9092
# Comma-separated consumer group IDs
Kafka__MonitoredConsumerGroups=
# Comma-separated DLQ topic names
Kafka__DlqTopics=
Kafka__ConsumerLagWarningThreshold=1000

# ── DevOps plugin ───────────────────────────────────────────────────────────
DevOps__OrgUrl=https://dev.azure.com/your-org
DevOps__PersonalAccessToken=
# Comma-separated Azure DevOps project names
DevOps__MonitoredProjects=
DevOps__LookbackHours=24

# ── Copilot Agent plugin ─────────────────────────────────────────────────────
# Set Enabled=true and configure CliPath in .env.local to activate agent operations.
# The CLI must be installed and authenticated before enabling.
# Override locally: copy the keys below into .env.local with your values.
CopilotAgent__Enabled=false
# Path to the gh copilot CLI extension (default: "gh copilot").
# Use an absolute path if the executable is not on PATH when running the API.
CopilotAgent__CliPath=gh copilot
# Working directory for CLI invocations. Leave empty to use the API process's CWD.
CopilotAgent__WorkingDirectory=
# Maximum seconds to wait for a single Copilot CLI call. Default: 120.
CopilotAgent__TimeoutSeconds=120
